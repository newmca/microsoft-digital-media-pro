<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.newmca.DmpKeys</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Digital Media Pro Keys</name>
  <summary>Remap Digital Media Pro keys</summary>
  <developer id="io.github.newmca">
    <name>newmca</name>
  </developer>

  <description>
    <p>
      Choose what the special keys and the zoom slider of the Microsoft Digital Media Pro
      Keyboard do on Linux. Pick an action for each key, such as launching an application,
      sending a media key or running a shortcut, and apply it with one click.
    </p>
    <p>
      The app also repairs the five My Favorites keys, which the kernel does not report by default.
      Changes are written to the system key mapping database and desktop shortcuts, and can be
      undone from the same window.
    </p>
    <p>
      Applying changes to the system asks for an administrator password. KDE Plasma and GNOME are supported.
    </p>
  </description>

  <launchable type="desktop-id">io.github.newmca.DmpKeys.desktop</launchable>

  <screenshots>
